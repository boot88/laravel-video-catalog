{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "fashion-video-hub",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:lan": "VITE_DEV_HOST=$(ip -4 route get 1 | awk '{print $7;exit}') vite",
        "serve": "php artisan serve",
        "server": "php artisan serve",
        "start": "php artisan serve",
        "serve:lan": "PHP_CLI_SERVER_WORKERS=6 php artisan serve --host=0.0.0.0 --port=8002",
        "mobile": "npm run build && rm -f public/hot && npm run serve:lan"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
